# Copy to .env.local and adjust as needed. All keys must be prefixed with VITE_.

# Base URL the axios client uses. Leave as "/api" in development so requests go
# through the Vite dev proxy (see vite.config.js — it forwards /api to
# http://localhost:5035). Set to the full API origin
# (e.g. https://api.chargesync.example/api) for a production build.
VITE_API_BASE_URL=/api
