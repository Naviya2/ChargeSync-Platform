# Add these to your local .env; never commit real keys.
LLM_PROVIDER=groq
GROQ_API_KEY=replace-with-your-groq-key
GROQ_MODEL=openai/gpt-oss-20b
# Must match the ASP.NET service key; this is NOT your Groq key.
AGENT_SERVICE_API_KEY=my-local-test-secret

# Optional local provider: set LLM_PROVIDER=ollama to use these.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:latest
